# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Postgres (own container; never STAIR's database) ─────────────────────────
POSTGRES_USER=tradelab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradelab
# DATABASE_URL is built by docker-compose.yml. Set it here only for running
# scripts outside compose, e.g. postgresql://tradelab:...@localhost:5432/tradelab

# ── Alpaca (PAPER ONLY) ──────────────────────────────────────────────────────
# Any value other than https://paper-api.alpaca.markets makes every entrypoint
# refuse to start.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# ── Telegram: a NEW bot for TradeLab (not @Avarela_tfg_bot) ───────────────────
TELEGRAM_BOT_TOKEN=
# Your personal chat id with the bot; the bot ignores every other chat.
TELEGRAM_CHAT_ID=

# ── Anthropic (Phase 2; set a monthly spend limit in the console) ────────────
ANTHROPIC_API_KEY=

# ── healthchecks.io (Phase 4; separate check from STAIR's) ────────────────────
HEALTHCHECK_URL=
